<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AIL Supplemental Policy Reference — American Income Life</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --ink:        #0d0d0d;
    --ink-2:      #1a1a1a;
    --ink-3:      #2c2c2c;
    --fog:        #f5f3ef;
    --fog-2:      #edeae4;
    --fog-3:      #e2ddd5;
    --parchment:  #faf8f4;
    --gold:       #8b6914;
    --gold-2:     #a07c1e;
    --gold-light: #c9a84c;
    --gold-pale:  #f0e6cc;
    --rule:       rgba(139,105,20,0.18);
    --rule-dark:  rgba(139,105,20,0.35);
    --muted:      #6b6560;
    --muted-2:    #9c9590;
    --danger:     #7a2020;
    --safe:       #1a4a2e;

    --a71: #6b3a2a;
    --a74: #2a3a5a;
    --c10: #1a4a2e;
    --c20: #2a3a5a;
    --ci:  #5a2a2a;
    --h34: #2a3a4a;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    background: var(--parchment);
    color: var(--ink);
    font-family: 'Inter', sans-serif;
    font-size: 13.5px;
    font-weight: 400;
    line-height: 1.65;
    min-height: 100vh;
  }

  /* ─── MASTHEAD ─── */
  .masthead {
    background: var(--ink);
    color: var(--fog);
    border-bottom: 3px solid var(--gold);
    position: relative;
    overflow: hidden;
  }
  .masthead::before {
    content: '';
    position: absolute; inset: 0;
    background: repeating-linear-gradient(
      90deg,
      transparent,
      transparent 60px,
      rgba(255,255,255,0.012) 60px,
      rgba(255,255,255,0.012) 61px
    );
    pointer-events: none;
  }
  .masthead-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 48px;
    display: flex;
    align-items: stretch;
    min-height: 72px;
  }
  .masthead-brand {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 20px 0;
    border-right: 1px solid rgba(255,255,255,0.1);
    padding-right: 32px;
    margin-right: 32px;
    flex-shrink: 0;
  }
  .brand-emblem {
    width: 36px; height: 36px;
    border: 1.5px solid var(--gold-light);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .brand-emblem svg { width: 18px; height: 18px; fill: var(--gold-light); }
  .brand-text {}
  .brand-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 16px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fog);
    line-height: 1;
    display: block;
  }
  .brand-sub {
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted-2);
    display: block;
    margin-top: 4px;
  }
  .masthead-nav {
    display: flex;
    align-items: center;
    gap: 2px;
    flex: 1;
  }
  .nav-btn {
    background: none; border: none; cursor: pointer;
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted-2);
    padding: 8px 20px;
    border-bottom: 2px solid transparent;
    margin-bottom: -3px;
    transition: color 0.2s, border-color 0.2s;
    white-space: nowrap;
  }
  .nav-btn:hover { color: var(--fog); }
  .nav-btn.active { color: var(--gold-light); border-bottom-color: var(--gold-light); }

  /* ─── HERO BANNER ─── */
  .hero {
    background: var(--ink-2);
    padding: 56px 48px 48px;
    position: relative;
    overflow: hidden;
  }
  .hero::after {
    content: 'AMERICAN INCOME LIFE';
    position: absolute;
    right: -20px; bottom: -30px;
    font-family: 'Cormorant Garamond', serif;
    font-size: 120px;
    font-weight: 300;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.025);
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
  }
  .hero-inner { max-width: 1200px; margin: 0 auto; }
  .hero-eyebrow {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--gold-light);
    margin-bottom: 18px;
    display: flex; align-items: center; gap: 12px;
  }
  .hero-eyebrow::before {
    content: '';
    width: 32px; height: 1px;
    background: var(--gold-light);
    display: block;
  }
  .hero h1 {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 300;
    line-height: 1.05;
    color: var(--fog);
    letter-spacing: -0.01em;
    margin-bottom: 20px;
  }
  .hero h1 em {
    font-style: italic;
    color: var(--gold-light);
  }
  .hero-desc {
    font-size: 13px;
    color: var(--muted-2);
    max-width: 540px;
    line-height: 1.75;
    margin-bottom: 36px;
  }
  .hero-products {
    display: flex; flex-wrap: wrap; gap: 0;
    border: 1px solid rgba(255,255,255,0.1);
    width: fit-content;
  }
  .hero-product {
    padding: 10px 20px;
    border-right: 1px solid rgba(255,255,255,0.1);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted-2);
    transition: color 0.2s, background 0.2s;
  }
  .hero-product:last-child { border-right: none; }
  .hero-product span { color: var(--gold-light); display: block; font-size: 13px; font-weight: 600; letter-spacing: 0.04em; margin-bottom: 1px; }

  /* ─── PAGE ─── */
  .page { max-width: 1200px; margin: 0 auto; padding: 0 48px 100px; }

  /* ─── SECTION DIVIDER ─── */
  .section-divider {
    display: flex; align-items: center; gap: 20px;
    margin: 52px 0 28px;
  }
  .section-divider::before, .section-divider::after {
    content: ''; flex: 1; height: 1px; background: var(--rule);
  }
  .section-divider::before { max-width: 40px; }
  .section-title-inner {
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--gold);
    white-space: nowrap;
  }

  /* ═══════════════════════════════
     QUICK BOOK
  ═══════════════════════════════ */
  .book-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }
  .book-card {
    background: var(--parchment);
    padding: 24px 22px 20px;
    position: relative;
    transition: background 0.2s;
  }
  .book-card:hover { background: white; }
  .book-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: var(--product-color, var(--gold));
  }
  .bc-code {
    font-family: 'Cormorant Garamond', serif;
    font-size: 30px;
    font-weight: 500;
    color: var(--product-color, var(--gold));
    line-height: 1;
    margin-bottom: 2px;
    letter-spacing: -0.01em;
  }
  .bc-form {
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted-2);
    margin-bottom: 16px;
  }
  .bc-rows { border-top: 1px solid var(--fog-3); }
  .bc-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
    padding: 5px 0;
    border-bottom: 1px solid var(--fog-3);
  }
  .bc-row:last-child { border-bottom: none; }
  .bc-key {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--muted);
    text-transform: uppercase;
    flex-shrink: 0;
  }
  .bc-val {
    font-size: 11.5px;
    font-weight: 500;
    color: var(--ink-3);
    text-align: right;
    line-height: 1.3;
  }
  .bc-renew {
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid var(--rule);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--muted-2);
    text-transform: uppercase;
  }
  .bc-renew strong {
    color: var(--product-color, var(--gold));
    display: block;
    font-size: 11px;
    margin-top: 2px;
  }

  /* Comparison Table */
  .compare-wrap {
    border: 1px solid var(--rule-dark);
    overflow-x: auto;
    margin-top: 4px;
  }
  .compare-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12.5px;
  }
  .compare-table thead {
    background: var(--ink);
  }
  .compare-table th {
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted-2);
    padding: 12px 16px;
    text-align: left;
    border-right: 1px solid rgba(255,255,255,0.06);
    white-space: nowrap;
  }
  .compare-table th:last-child { border-right: none; }
  .compare-table tbody tr {
    border-bottom: 1px solid var(--fog-3);
    transition: background 0.15s;
  }
  .compare-table tbody tr:hover { background: var(--gold-pale); }
  .compare-table tbody tr:last-child { border-bottom: none; }
  .compare-table td {
    padding: 10px 16px;
    border-right: 1px solid var(--fog-3);
    vertical-align: middle;
    color: var(--ink-3);
  }
  .compare-table td:last-child { border-right: none; }
  .compare-table td:first-child {
    font-family: 'Cormorant Garamond', serif;
    font-size: 20px;
    font-weight: 500;
    color: var(--product-color, var(--gold));
    white-space: nowrap;
  }
  .yes {
    color: var(--safe);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.06em;
  }
  .no {
    color: var(--danger);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.06em;
  }

  /* ═══════════════════════════════
     SUMMARY CARDS
  ═══════════════════════════════ */
  .summary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 20px;
  }
  .scard {
    background: white;
    border: 1px solid var(--fog-3);
    border-top: 3px solid var(--product-color, var(--gold));
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .scard:hover {
    box-shadow: 0 8px 32px rgba(0,0,0,0.08);
    transform: translateY(-2px);
  }
  .scard-header {
    padding: 22px 26px 18px;
    border-bottom: 1px solid var(--fog-3);
    display: flex; align-items: flex-start; gap: 16px;
  }
  .scard-code-block {
    flex-shrink: 0;
  }
  .scard-code {
    font-family: 'Cormorant Garamond', serif;
    font-size: 40px; font-weight: 500;
    color: var(--product-color, var(--gold));
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .scard-form {
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted-2);
    margin-top: 2px;
  }
  .scard-header-text { flex: 1; padding-top: 4px; }
  .scard-header-text h3 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 20px;
    font-weight: 500;
    color: var(--ink);
    line-height: 1.2;
    margin-bottom: 4px;
  }
  .scard-header-text p {
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .scard-body { padding: 22px 26px; }
  .scard-desc {
    font-size: 13px;
    color: var(--ink-3);
    line-height: 1.72;
    margin-bottom: 20px;
  }
  .scard-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .stat-box {
    background: var(--fog);
    padding: 10px 14px;
    border-left: 2px solid var(--product-color, var(--gold));
  }
  .stat-box .s-label {
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted-2);
    margin-bottom: 4px;
  }
  .stat-box .s-val {
    font-size: 13px;
    font-weight: 500;
    color: var(--ink);
    line-height: 1.3;
  }
  .stat-box .s-val.accent { color: var(--product-color, var(--gold)); font-weight: 600; }

  /* ═══════════════════════════════
     DEEP DIVE
  ═══════════════════════════════ */
  .deep-container { display: flex; flex-direction: column; gap: 1px; background: var(--rule); border: 1px solid var(--rule); }

  .deep-card { background: var(--parchment); }
  .deep-card.open { background: white; }

  .deep-card-header {
    padding: 22px 32px;
    display: flex;
    align-items: center;
    gap: 24px;
    cursor: pointer;
    user-select: none;
    border-left: 3px solid var(--product-color, var(--gold));
    transition: background 0.15s;
  }
  .deep-card-header:hover { background: var(--gold-pale); }
  .deep-card.open .deep-card-header { border-bottom: 1px solid var(--rule); }

  .deep-badge {
    font-family: 'Cormorant Garamond', serif;
    font-size: 32px;
    font-weight: 500;
    color: var(--product-color, var(--gold));
    line-height: 1;
    width: 56px;
    flex-shrink: 0;
  }
  .deep-meta { flex: 1; }
  .deep-meta h2 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 20px;
    font-weight: 500;
    color: var(--ink);
    margin-bottom: 3px;
    line-height: 1.2;
  }
  .deep-meta p {
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .deep-chevron {
    font-size: 11px;
    color: var(--muted-2);
    transition: transform 0.3s;
    flex-shrink: 0;
    letter-spacing: 0.05em;
    font-weight: 500;
  }
  .deep-card.open .deep-chevron { transform: rotate(180deg); }

  .deep-body {
    display: none;
    padding: 36px 32px 36px 115px;
  }
  .deep-card.open .deep-body { display: block; }

  .deep-section { margin-bottom: 32px; }
  .deep-section:last-child { margin-bottom: 0; }

  .deep-section-title {
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 14px;
    display: flex; align-items: center; gap: 12px;
  }
  .deep-section-title::after {
    content: ''; flex: 1; height: 1px; background: var(--rule);
  }

  .deep-section p {
    font-size: 13px;
    color: var(--ink-3);
    line-height: 1.75;
    max-width: 680px;
  }

  .benefit-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1px;
    background: var(--fog-3);
    border: 1px solid var(--fog-3);
  }
  .benefit-item {
    background: white;
    padding: 14px 18px;
    border-left: 2px solid var(--product-color, var(--gold));
  }
  .b-name {
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 6px;
  }
  .b-val {
    font-size: 12.5px;
    color: var(--ink-3);
    line-height: 1.55;
  }

  .exclusion-list { list-style: none; max-width: 640px; }
  .exclusion-list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 7px 0;
    border-bottom: 1px solid var(--fog-3);
    font-size: 12.5px;
    color: var(--ink-3);
    line-height: 1.5;
  }
  .exclusion-list li:last-child { border-bottom: none; }
  .excl-mark {
    flex-shrink: 0;
    width: 16px; height: 16px;
    border: 1px solid var(--danger);
    display: flex; align-items: center; justify-content: center;
    font-size: 8px;
    color: var(--danger);
    font-weight: 700;
    margin-top: 1px;
  }

  .key-points {
    background: var(--fog);
    border: 1px solid var(--rule-dark);
    border-left: 3px solid var(--gold);
    padding: 20px 24px;
    max-width: 700px;
  }
  .kp-title {
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 14px;
  }
  .kp-list { list-style: none; }
  .kp-list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 6px 0;
    border-bottom: 1px solid var(--rule);
    font-size: 12.5px;
    color: var(--ink-3);
    line-height: 1.55;
  }
  .kp-list li:last-child { border-bottom: none; }
  .kp-mark {
    flex-shrink: 0;
    color: var(--gold);
    font-size: 10px;
    margin-top: 3px;
  }

  /* ─── VIEWS ─── */
  .view { display: none; }
  .view.active { display: block; }

  /* ─── BOTTOM NAV ─── */
  .bottom-nav {
    position: fixed;
    bottom: 24px; left: 50%;
    transform: translateX(-50%);
    background: var(--ink);
    border: 1px solid rgba(201,168,76,0.3);
    display: flex;
    box-shadow: 0 12px 40px rgba(0,0,0,0.3);
    z-index: 99;
    overflow: hidden;
  }
  .bottom-nav button {
    background: none; border: none; cursor: pointer;
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.45);
    padding: 12px 24px;
    border-right: 1px solid rgba(255,255,255,0.07);
    transition: color 0.2s, background 0.2s;
  }
  .bottom-nav button:last-child { border-right: none; }
  .bottom-nav button:hover { color: rgba(255,255,255,0.8); }
  .bottom-nav button.active {
    background: var(--gold);
    color: var(--ink);
  }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 768px) {
    .masthead-inner { padding: 0 20px; }
    .hero { padding: 40px 20px 36px; }
    .hero::after { display: none; }
    .page { padding: 0 20px 100px; }
    .hero-products { display: none; }
    .masthead-brand { display: none; }
    .summary-grid { grid-template-columns: 1fr; }
    .deep-body { padding: 24px 20px; }
    .deep-card-header { padding: 18px 20px; }
    .deep-badge { width: 44px; font-size: 26px; }
    .book-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 480px) {
    .book-grid { grid-template-columns: 1fr; }
  }
</style>
</head>
<body>

<!-- MASTHEAD -->
<header class="masthead">
  <div class="masthead-inner">
    <div class="masthead-brand">
      <div class="brand-emblem">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 2L3 7v5c0 5.25 3.75 10.15 9 11.35C17.25 22.15 21 17.25 21 12V7L12 2zm0 2.18l7 3.89V12c0 4.34-2.96 8.42-7 9.72-4.04-1.3-7-5.38-7-9.72V8.07l7-3.89z"/>
        </svg>
      </div>
      <div class="brand-text">
        <span class="brand-name">American Income Life</span>
        <span class="brand-sub">Supplemental Policy Reference</span>
      </div>
    </div>
    <nav class="masthead-nav">
      <button class="nav-btn active" onclick="switchView('quickbook')">Quick Reference</button>
      <button class="nav-btn" onclick="switchView('summary')">Product Summaries</button>
      <button class="nav-btn" onclick="switchView('deepdive')">Full Policy Guide</button>
    </nav>
  </div>
</header>

<!-- HERO -->
<div class="hero">
  <div class="hero-inner">
    <div class="hero-eyebrow">Agent Training Material</div>
    <h1>Supplemental<br><em>Policy Reference</em></h1>
    <p class="hero-desc">A comprehensive guide to the six AIL supplemental products — from quick-access field reference to complete policy analysis for agent certification and client consultation.</p>
    <div class="hero-products">
      <div class="hero-product"><span>A71</span>Accident Only</div>
      <div class="hero-product"><span>A74</span>Accident + Disability</div>
      <div class="hero-product"><span>C10</span>Cancer Daily</div>
      <div class="hero-product"><span>C20</span>Cancer Lump Sum</div>
      <div class="hero-product"><span>CI</span>Critical Illness</div>
      <div class="hero-product"><span>H34</span>Hospital Indemnity</div>
    </div>
  </div>
</div>

<div class="page">

<!-- ══════════════════════════════════
     QUICK BOOK VIEW
══════════════════════════════════ -->
<div id="view-quickbook" class="view active">

