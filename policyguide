<script>
  function switchView(v) {
    document.querySelectorAll('.view').forEach(el => el.classList.remove('active'));
    document.getElementById('view-' + v).classList.add('active');
    const map = { quickbook:0, summary:1, deepdive:2 };
    document.querySelectorAll('.nav-btn').forEach((b,i) => b.classList.toggle('active', i === map[v]));
    document.querySelectorAll('.bottom-nav button').forEach((b,i) => b.classList.toggle('active', i === map[v]));
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }
  function toggleDeep(id) {
    document.getElementById('deep-' + id).classList.toggle('open');
  }
</script>

